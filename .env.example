# ---------------------------------------------------------------------------
# Enterprise Metadata Copilot - environment template
# Copy to .env and adjust. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=Enterprise Metadata Copilot
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL (structured metadata catalog) -------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=emc
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=metadata_copilot
# Optional full override (async driver). Leave blank to build from the parts above.
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Neo4j (lineage graph projection) ---------------------------------------
GRAPH_STORE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_DATABASE=neo4j

# --- LLM provider (pluggable) -----------------------------------------------
# mock | openai | azure_openai
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

# --- Embeddings (pluggable) -------------------------------------------------
# hash | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# --- Vector store (pluggable) -----------------------------------------------
# pgvector | memory
VECTOR_STORE=pgvector

# --- Retrieval / RAG --------------------------------------------------------
RAG_TOP_K=8
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
HYBRID_KEYWORD_WEIGHT=0.4
HYBRID_SEMANTIC_WEIGHT=0.6

# --- Lineage ----------------------------------------------------------------
LINEAGE_DEFAULT_DEPTH=3
LINEAGE_MAX_DEPTH=15
LINEAGE_MIN_CONFIDENCE=0.3
LINEAGE_AUTO_VERIFY_THRESHOLD=0.99

# --- Security / enterprise auth readiness -----------------------------------
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=RS256
JWT_AUDIENCE=enterprise-metadata-copilot
JWT_ISSUER=
DEFAULT_PRINCIPAL=local-developer

# --- Ingestion --------------------------------------------------------------
# 0 disables the in-process scheduler (recommended outside local development).
INGESTION_SCHEDULE_SECONDS=0
INGESTION_BATCH_SIZE=500

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
